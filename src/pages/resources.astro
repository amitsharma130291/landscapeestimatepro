---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ToolCardGrid from "../components/ToolCardGrid.astro";

const title = "Free Landscaping Estimating Resources — Calculators & Templates";
const description =
  "Free landscaping estimating resources: cost calculator, estimate calculator, estimate/quote/invoice templates, price list builder, and a pricing guide.";
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Resources", href: "/resources/" }]} />

  <section class="mx-auto max-w-content px-4 py-12 sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-lime-surface">Resources</p>
    <h1 class="mt-2 max-w-2xl text-[clamp(1.9rem,4.5vw,2.75rem)] font-extrabold text-ink">
      Free tools for pricing and estimating landscape work.
    </h1>
    <p class="mt-3 max-w-2xl text-muted">
      Every calculator and template below runs the same true-cost-and-margin math Landscape Estimate Pro is built on.
    </p>
  </section>

  <section class="mx-auto max-w-content px-4 pb-16 sm:px-6 lg:px-8">
    <ToolCardGrid />
  </section>
</Layout>
