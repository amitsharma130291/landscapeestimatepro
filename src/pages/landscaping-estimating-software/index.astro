<script>
  import { startCheckout } from "../../lib/license";

  // A plain vanilla-JS click handler for every non-hydrated "Get Pro" button
  // on this page (hero, mid-page, final CTA, sticky bar) — startCheckout()
  // is a plain async function with no React dependency, so these buttons
  // don't need a React island just to trigger it. Only the pricing section
  // keeps a real <PurchaseButton client:load> (loading/error state matters
  // most right at the point of purchase); every other "Get Pro" button
  // reuses this one shared handler instead of hydrating its own copy of the
  // same component. CTA copy varies by placement; the destination and
  // behavior triggered here never does.
  document.querySelectorAll<HTMLButtonElement>(".js-buy-cta").forEach((button) => {
    button.addEventListener("click", async () => {
      if (button.disabled) return;
      const wrap = button.closest(".js-buy-cta-wrap");
      const errorEl = wrap?.querySelector<HTMLElement>(".js-buy-cta-error");
      button.disabled = true;
      errorEl?.classList.add("hidden");
      try {
        await startCheckout();
        // startCheckout() redirects the browser on success — nothing left to do.
      } catch (err) {
        button.disabled = false;
        if (errorEl) {
          errorEl.textContent = err instanceof Error ? err.message : "Couldn't start checkout. Please try again.";
          errorEl.classList.remove("hidden");
        }
      }
    });
  });

  const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Financial numbers on this page are always the real, final, server-rendered
  // value — never an animated count-up. A count-up necessarily shows wrong
  // intermediate numbers while it runs, which is not acceptable on a page
  // whose whole argument is "these numbers are exact." Only a plain
  // opacity/position reveal (see global.css's .reveal-item) is used here.
  const revealItems = document.querySelectorAll<HTMLElement>(".reveal-item");

  if (reduceMotionQuery.matches) {
    revealItems.forEach((el) => el.classList.add("is-visible"));
  } else if (revealItems.length > 0) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    revealItems.forEach((el) => observer.observe(el));
  }
</script>
