---
import ToolPageLayout from "../../layouts/ToolPageLayout.astro";
import InvoiceBuilderIsland from "../../components/calculator/InvoiceBuilderIsland.tsx";

const faqs = [
  {
    question: "Does this calculate sales tax automatically?",
    answer:
      "No — enter your own tax percentage and the total updates automatically. Tax rules vary by state and by whether labor is taxable, so this template keeps tax as a field you control rather than guessing at it.",
  },
  {
    question: "Is this full accounting software?",
    answer:
      "No, and it's not meant to be. This is a simple, printable invoice for a completed landscaping job. Landscape Estimate Pro focuses on estimating and job costing, not bookkeeping or payment processing.",
  },
  {
    question: "Can I reuse the services from my estimate on the invoice?",
    answer:
      "In the free template, you re-enter them. Pro lets you convert a saved estimate directly into a completed-job record for estimate-vs-actual tracking.",
  },
];
---

<ToolPageLayout
  title="Landscaping Invoice Template — Free Invoice Builder"
  description="Free landscaping invoice template. Bill a completed job with an itemized invoice, your own tax rate, and a total — print or save as a PDF."
  eyebrow="Free interactive template"
  h1="Landscaping Invoice Template"
  intro="Bill a completed landscaping job with a simple, itemized invoice (also called a landscape invoice template) — your business, the customer, services rendered, tax, and a total."
  breadcrumbLabel="Landscaping Invoice Template"
  currentHref="/landscaping-invoice-template/"
  faqs={faqs}
  webApplicationSchema={false}
>
  <InvoiceBuilderIsland client:load />

  <Fragment slot="extra">
    <article class="tool-editorial mb-10">
      <h2>Prepare an invoice from the completed scope</h2>
      <p>Enter the business and customer details, an invoice number, the invoice date, and the services delivered. Put the payment due date or payment terms in the notes field. Use quantities and selling rates that match the work being billed. Review any agreed additions or reductions instead of simply copying the original estimate unchanged.</p>
      <p>The invoice total is not the job's profit. Supplier bills, paid crew time, and equipment charges belong in your cost records. Use the <a href="/landscape-job-cost-calculator/">job cost calculator</a> to compare that spending against the pre-tax invoiced revenue, then keep this invoice focused on what the customer owes.</p>
      <h2>Check the tax basis before printing</h2>
      <p>This simple builder applies your entered tax percentage to the entire subtotal. It does not support different tax treatment per line or determine which services are taxable. If your invoice needs mixed taxable and exempt items, use an invoicing tool that supports those rules. Review the subtotal, calculated tax, and final amount against your own records before saving the PDF.</p>
      <h2>Keep a record after sending</h2>
      <p>Print the invoice or save it as a PDF through your browser. Keep a copy in your bookkeeping system and record payments there. This free builder does not send invoices, collect payments, track overdue balances, or save your entries between visits. If the customer needs the scope priced before work begins, start with the <a href="/landscaping-quote-template/">quote template</a> instead.</p>
    </article>
    <div class="rounded-2xl border border-border bg-paper p-6">
      <h2 class="text-xl font-bold text-ink">Estimating and invoicing, without the accounting bloat</h2>
      <p class="mt-2 text-sm text-muted">
        Landscape Estimate Pro focuses on the estimating and job-costing problem — what a job costs you and what to
        charge — rather than becoming full accounting software. Use whatever bookkeeping tool you already have for
        payments and taxes.
      </p>
      <p class="mt-3 text-sm text-muted">
        Haven't priced the job yet? Start with our <a href="/landscaping-estimate-template/" class="font-semibold text-forest underline">landscaping estimate template</a> to
        send a customer-ready price before the work begins — then come back here to invoice the completed job.
      </p>
    </div>
  </Fragment>
</ToolPageLayout>
