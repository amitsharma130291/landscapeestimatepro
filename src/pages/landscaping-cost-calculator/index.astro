---
import ToolPageLayout from "../../layouts/ToolPageLayout.astro";
import ProjectCalculatorIsland from "../../components/calculator/ProjectCalculatorIsland.tsx";
import { PRICE_DISPLAY, ORIGINAL_PRICE_DISPLAY, LAUNCH_PRICE_ACTIVE } from "../../data/site";

const faqs = [
  {
    question: "What counts as \"overhead\" in this calculator?",
    answer:
      "Overhead is the cost of running your business that isn't tied to one specific job — insurance, vehicle payments, office/admin time, and similar fixed costs. Most contractors express it as a percentage of direct job cost (materials + labor + equipment + delivery + other) and apply it to every estimate.",
  },
  {
    question: "Why is the required price higher than cost plus a markup would suggest?",
    answer:
      "Because this calculator solves for margin (profit ÷ selling price), not markup (profit ÷ cost). A 35% markup on a $2,850 true cost only produces a 25.9% margin. Solving for a true 35% margin requires a higher price: cost ÷ (1 − margin).",
  },
  {
    question: "Does this calculator save my numbers?",
    answer: LAUNCH_PRICE_ACTIVE
      ? `No — this free calculator recalculates fresh each time and doesn't save anything between visits. Landscape Estimate Pro (${PRICE_DISPLAY} launch price, regular ${ORIGINAL_PRICE_DISPLAY}) saves your materials, labor, equipment, and every estimate to your device.`
      : `No — this free calculator recalculates fresh each time and doesn't save anything between visits. Landscape Estimate Pro (${PRICE_DISPLAY} lifetime) saves your materials, labor, equipment, and every estimate to your device.`,
  },
  {
    question: "Is this the same as a landscaping estimate calculator?",
    answer:
      "This calculator starts with category totals for a quick cost check. The estimate calculator lets you build quantities and unit costs across multiple services before applying project overhead and margin.",
  },
];
---

<ToolPageLayout
  title="Landscaping Cost Calculator — Free True Cost & Pricing Tool"
  description="Free landscaping cost calculator (also used as a landscape cost calculator). Enter your costs to get your true project cost and required price."
  eyebrow="Free landscaping cost calculator"
  h1="Landscaping Cost Calculator"
  intro="Enter what a project actually costs your business. This calculator adds overhead into your true cost, then solves for the selling price required to hit your target margin — not just a markup guess."
  breadcrumbLabel="Landscaping Cost Calculator"
  currentHref="/landscaping-cost-calculator/"
  faqs={faqs}
>
  <ProjectCalculatorIsland client:load />

  <Fragment slot="extra">
    <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">What affects a landscaping project's true cost?</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { title: "Materials", desc: "Mulch, soil, gravel, plants, pavers, edging — priced at what your supplier actually charges you, not a list price." },
        { title: "Labor", desc: "Loaded crew cost per person-hour, including wages, payroll tax, and benefits — not just take-home pay." },
        { title: "Equipment", desc: "Owned or rented equipment time: skid steers, dump trailers, compactors, billed by the hour, day, or job." },
        { title: "Delivery", desc: "Hauling materials to the site and debris away from it — easy to forget, and it adds up fast on bulky jobs." },
        { title: "Overhead", desc: "Insurance, vehicles, admin time, and other costs that exist whether or not this specific job runs." },
        { title: "Target margin", desc: "The profit share of your selling price you're protecting — set deliberately, not left to chance." },
      ].map((item) => (
        <div class="rounded-2xl border border-border bg-paper p-5">
          <h3 class="font-bold text-ink">{item.title}</h3>
          <p class="mt-1.5 text-sm text-muted">{item.desc}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 max-w-2xl text-sm text-muted">
      Pricing one project? Our <a href="/landscaping-estimate-calculator/" class="font-semibold text-forest underline">landscaping estimate calculator</a>
      builds up service quantities and direct unit costs before applying shared project expenses.
    </p>
    <article class="tool-editorial mt-10">
      <h2>Build the inputs before solving the selling price</h2>
      <p>For bulk materials, calculate quantities and supplier costs with the <a href="/mulch-cost-calculator/">mulch cost calculator</a> or <a href="/topsoil-cost-calculator/">topsoil cost calculator</a>. Add the material amount here and put delivery in its separate field. Do not transfer an installed selling price into a material-cost field.</p>
      <p>The <a href="/landscape-labor-cost-calculator/">landscape labor cost calculator</a> converts wages, paid time, and payroll burden into a direct labor total. Bring that direct cost here, then apply overhead once at project level. For a check on a price you already charge, use the <a href="/landscape-profit-margin-calculator/">margin versus markup calculator</a>.</p>
      <h2>Check the estimate after the work is finished</h2>
      <p>Save the original numbers with your project records. Once supplier bills and crew time are available, compare them in the <a href="/landscape-job-cost-calculator/">landscape job cost calculator</a>. Repeated differences are a reason to revisit your assumptions before quoting the next similar job.</p>
    </article>
  </Fragment>
</ToolPageLayout>
