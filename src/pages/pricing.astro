---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import PurchaseButton from "../components/PurchaseButton.tsx";
import LicenseActivationSection from "../components/LicenseActivationSection.tsx";
import LaunchPriceTag from "../components/salespage/LaunchPriceTag.astro";
import { PRICE_DISPLAY, ORIGINAL_PRICE_DISPLAY, LAUNCH_PRICE_ACTIVE, SITE_URL } from "../data/site";
import { buildOfferSchema } from "../data/salesConfig";
import { PRODUCT_IMAGE_URL } from "../data/structuredData";

const title = `Pricing — Landscape Estimate Pro (${PRICE_DISPLAY} Lifetime)`;
const description = LAUNCH_PRICE_ACTIVE
  ? `Landscape Estimate Pro is ${PRICE_DISPLAY} launch price (regular ${ORIGINAL_PRICE_DISPLAY}), one time — no subscription. Local-first storage, no account required.`
  : `Landscape Estimate Pro is ${PRICE_DISPLAY}, one time — no subscription. Local-first storage, no account required.`;

const offer = buildOfferSchema(`${SITE_URL}/pricing/`);
// SoftwareApplication, not Product — Product structured data puts a page
// into Google's Merchant/Shopping graph (Merchant listings, product
// snippets), which expects a real Merchant Center feed (shipping,
// reviews, returns policy in a specific format) this site doesn't have
// and shouldn't claim to. SoftwareApplication + offers is the correct,
// intentional type for priced software — same as the other two pages
// that carry this same offer (/ and /landscaping-estimating-software/).
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Landscape Estimate Pro",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any (runs in browser)",
  url: `${SITE_URL}/pricing/`,
  description,
  image: PRODUCT_IMAGE_URL,
  ...(offer ? { offers: offer } : {}),
};

const faqs = [
  {
    question: "How do I get access after I buy?",
    answer:
      "Right after payment you're redirected straight into the app, already unlocked. You'll also get an email with your license key and a link back to the app, in case you close the tab first.",
  },
  {
    question: "I bought Pro but lost my license key. What do I do?",
    answer: `Use "Forgot your license key?" below — enter the email you paid with and we'll email it to you. You can also paste the key directly if you still have it.`,
  },
  {
    question: "What if it's not for me?",
    answer: "We offer a 7-day, no-questions-asked refund. Contact us within 7 days of purchase and we'll refund it in full.",
  },
  {
    question: "What happens to my data?",
    answer:
      "Everything you enter — materials, labor rates, equipment, assemblies, and estimates — stays on your device in your browser's local storage. Nothing is uploaded to a server. Use JSON export/import to back up your workspace or move it to another device.",
  },
  {
    question: "What will it cost?",
    answer: LAUNCH_PRICE_ACTIVE
      ? `A one-time ${PRICE_DISPLAY} launch price (regular ${ORIGINAL_PRICE_DISPLAY}), lifetime — no subscription, ever.`
      : `A one-time ${PRICE_DISPLAY}, lifetime — no subscription, ever.`,
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pricing", href: "/pricing/" }]} />

  <section class="mx-auto max-w-content px-4 py-12 text-center sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-lime-surface">Pricing</p>
    <h1 class="mt-2 text-[clamp(2rem,4.5vw,3rem)] font-extrabold text-ink">One price, lifetime.</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">
      One-time payment for lifetime access. Your project workspace stays in this browser; checkout and license verification use our payment service. No subscription or account password.
    </p>
  </section>

  <section class="mx-auto max-w-content px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-lg rounded-3xl border border-forest bg-forest p-8 text-white shadow-xl sm:p-10">
      <h2 class="text-lg font-bold text-lime">Landscape Estimate Pro</h2>
      <div class="mt-2"><LaunchPriceTag /></div>
      <p class="mt-2 text-white/70">one-time payment, lifetime</p>

      <ul class="mt-7 space-y-3 text-sm">
        {[
          "One-time payment — no subscription, ever",
          "Unlimited estimates and saved projects",
          "All Pro estimating and job-costing features",
          "Saved material, labor and equipment catalogs",
          "Reusable service assemblies and project templates",
          "Service Rate Health and required-price solver",
          "Material, labor and equipment cost-impact scenarios",
          "Estimate-vs-actual tracking",
          "Branded customer estimates, CSV export, JSON backup",
          "Project data stored in this browser — export a backup",
        ].map((item) => (
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <PurchaseButton client:load />
      </div>
      <p class="mt-3 text-center text-xs text-white/60">
        Review the <a href="/refund/" class="underline">refund policy</a> before purchasing.
      </p>
    </div>

    <div class="mx-auto mt-8 max-w-lg">
      <LicenseActivationSection client:load />
    </div>
  </section>

  <section class="border-t border-border bg-white py-16">
    <div class="mx-auto max-w-narrow px-4 sm:px-6 lg:px-8">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</Layout>
