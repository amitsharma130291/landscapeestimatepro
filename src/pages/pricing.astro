---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import PurchaseButton from "../components/PurchaseButton.tsx";
import { PRICE_DISPLAY, SITE_URL } from "../data/site";
import { buildOfferSchema } from "../data/salesConfig";
import { PRODUCT_IMAGE_URL } from "../data/structuredData";

const title = `Pricing — Landscape Estimate Pro (${PRICE_DISPLAY} Lifetime, Planned)`;
const description = `Landscape Estimate Pro's planned price is ${PRICE_DISPLAY}, one time — purchasing isn't open yet, and the app is fully usable today for building and testing. Local-first storage, no account.`;

const offer = buildOfferSchema(`${SITE_URL}/pricing/`);
const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Landscape Estimate Pro",
  description,
  image: PRODUCT_IMAGE_URL,
  ...(offer ? { offers: offer } : {}),
};

const faqs = [
  {
    question: "Can I buy Pro right now?",
    answer: "Not yet — purchasing isn't open. Nothing on this page collects payment or activates anything.",
  },
  {
    question: "Can I use Pro before purchasing opens?",
    answer: "Yes — the full app is usable today for building and testing your catalog, estimates, and quotes. There's no login or account either way.",
  },
  {
    question: "What will it cost once purchasing opens?",
    answer: `The planned price is a one-time ${PRICE_DISPLAY}, lifetime — no subscription, ever. That's a plan, not an active offer, until purchasing is actually open.`,
  },
  {
    question: "What happens to my data?",
    answer:
      "Everything you enter — materials, labor rates, equipment, assemblies, and estimates — stays on your device in your browser's local storage. Nothing is uploaded to a server, now or after purchasing opens. Use JSON export/import to back up your workspace or move it to another device.",
  },
  {
    question: "Are the free tools actually free, with no catch?",
    answer:
      "Yes. The free calculators and templates on this site (cost calculator, estimate/quote/invoice templates, price list) are free to use with no time limit and no account.",
  },
];
---

<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>

  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Pricing", href: "/pricing/" }]} />

  <section class="mx-auto max-w-content px-4 py-12 text-center sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-lime-surface">Pricing</p>
    <h1 class="mt-2 text-[clamp(2rem,4.5vw,3rem)] font-extrabold text-ink">One price, planned. Not yet open.</h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">
      Purchasing isn't active yet. Use the full app today to build and test your catalog and estimates — the planned
      lifetime price below is where things stand when it opens.
    </p>
  </section>

  <section class="mx-auto max-w-content px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-lg rounded-3xl border border-forest bg-forest p-8 text-white shadow-xl sm:p-10">
      <h2 class="text-lg font-bold text-lime">Landscape Estimate Pro</h2>
      <p class="mt-2 text-6xl font-extrabold">{PRICE_DISPLAY}</p>
      <p class="text-white/70">planned one-time payment, lifetime — purchasing not yet open</p>

      <ul class="mt-7 space-y-3 text-sm">
        {[
          "One-time payment, planned — no subscription, ever",
          "Unlimited estimates and saved projects",
          "All Pro estimating and job-costing features",
          "Saved material, labor and equipment catalogs",
          "Reusable service assemblies and project templates",
          "Service Rate Health and required-price solver",
          "Material, labor and equipment cost-impact scenarios",
          "Estimate-vs-actual tracking",
          "Branded customer estimates, CSV export, JSON backup",
          "Local-first storage — nothing leaves your device",
        ].map((item) => (
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-8">
        <PurchaseButton client:load />
      </div>
    </div>
    <p class="mx-auto mt-4 max-w-lg text-center text-sm text-muted">
      Every feature above is already usable in <a href="/app/" class="font-semibold text-forest underline">the app</a> today, free, while purchasing is closed.
    </p>
  </section>

  <section class="border-t border-border bg-white py-16">
    <div class="mx-auto max-w-narrow px-4 sm:px-6 lg:px-8">
      <FaqAccordion faqs={faqs} />
    </div>
  </section>
</Layout>
