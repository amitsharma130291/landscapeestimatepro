---
import ToolPageLayout from "../../layouts/ToolPageLayout.astro";
import EstimateBuilderIsland from "../../components/calculator/EstimateBuilderIsland.tsx";
import { PRICE_DISPLAY, ORIGINAL_PRICE_DISPLAY, LAUNCH_PRICE_ACTIVE } from "../../data/site";

const faqs = [
  {
    question: "Is this a downloadable Excel template?",
    answer:
      "No — it's an interactive estimate builder you fill in directly in your browser, then print or save as a PDF. There's nothing to download or install, and no spreadsheet formulas to break.",
  },
  {
    question: "Can I customize the services and pricing?",
    answer: "Yes. Add or remove line items freely, and enter your own quantities, units, and prices for each service.",
  },
  {
    question: "How is this different from the quote template?",
    answer:
      "This estimate shows quantities and unit prices to explain a provisional scope. The quote builder also offers a summary presentation for an agreed customer price. Both are customer documents; calculate internal costs separately before entering selling rates.",
  },
  {
    question: "Can I save my materials and labor costs so I don't retype them every time?",
    answer:
      "The free template starts fresh each visit. Pro stores material and equipment catalogs and service assemblies. Enter job quantities and review your saved rates to calculate a new estimate.",
  },
];
---

<ToolPageLayout
  title="Landscaping Estimate Template — Free Estimate Builder"
  description="Free landscaping estimate template. Fill in your business, customer, project and services, then print or save your estimate as a PDF — no spreadsheet required."
  eyebrow="Free interactive template"
  h1="Landscaping Estimate Template"
  intro="A clean, customer-ready estimate (also called a landscape estimate template) you fill in directly — business details, customer, project, line-item services, and a total. Print it or save it as a PDF when you're done."
  breadcrumbLabel="Landscaping Estimate Template"
  currentHref="/landscaping-estimate-template/"
  faqs={faqs}
  webApplicationSchema={false}
>
  <EstimateBuilderIsland variant="estimate" client:load />

  <Fragment slot="extra">
    <article class="tool-editorial mb-10">
      <h2>Prepare a provisional scope the customer can understand</h2>
      <p>Use an estimate when quantities or site conditions still need confirmation. Describe each service, its measured quantity, the unit, and the customer selling rate. The builder multiplies quantity by rate and adds the line totals; it does not infer your material, labor, or equipment costs from the service name.</p>
      <h2>Example: show what the quantity means</h2>
      <p>Eight cubic yards of mulch installation at $95 per yard totals $760. Eighteen shrubs installed at $65 each totals $1,170. The sample estimate is $1,930 before any separately stated adjustments. Those are example selling rates, not suggested prices. State whether supply, preparation, disposal, and cleanup are included so a customer can compare scopes accurately.</p>
      <p>Use the notes field to record assumptions such as final bed measurements, access to the work area, and exclusions. Review quantities after the site visit before treating a provisional estimate as the agreed scope. Keep your internal labor and supplier costs in your own working estimate rather than copying them into the customer notes.</p>
      <h2>Cost first, document second</h2>
      <p>Build service costs with the <a href="/landscaping-estimate-calculator/">multi-service estimate calculator</a>. For material quantities, use the <a href="/mulch-cost-calculator/">mulch calculator</a> or <a href="/topsoil-cost-calculator/">topsoil calculator</a>. Transfer reviewed selling rates here, then print or choose Save as PDF in your browser's print dialog.</p>
      <p>Once the scope and price are ready to present as a quote, the <a href="/landscaping-quote-template/">quote builder</a> lets you choose detailed or summary lines. These free tools do not transfer entries between pages or save documents between visits, so save the PDF before leaving.</p>
    </article>
    <div class="rounded-2xl border border-lime-surface bg-mint p-6">
      <h2 class="text-xl font-bold text-mint-ink">Reuse a saved service cost when preparing the next estimate.</h2>
      <p class="mt-2 text-sm text-mint-ink">That's what Landscape Estimate Pro does — reusable catalogs, service assemblies, and saved estimates, {PRICE_DISPLAY} lifetime{LAUNCH_PRICE_ACTIVE && <> (launch price — regular {ORIGINAL_PRICE_DISPLAY})</>}.</p>
      <a href="/landscaping-estimating-software/" class="mt-4 inline-flex min-h-[44px] items-center justify-center rounded-xl bg-forest px-5 text-sm font-bold text-white hover:bg-forest-light">
        See Landscape Estimating Software
      </a>
    </div>
  </Fragment>
</ToolPageLayout>
