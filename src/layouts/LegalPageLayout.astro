---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

export interface Props {
  title: string;
  description: string;
  h1: string;
  updated: string;
}

const { title, description, h1, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: h1, href: Astro.url.pathname }]} />
  <article class="mx-auto max-w-narrow px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-ink">{h1}</h1>
    <p class="mt-2 text-sm text-muted">Last updated {updated}</p>
    <div class="legal-content mt-8">
      <slot />
    </div>
  </article>
</Layout>

<style>
  .legal-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .legal-content :global(p) {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: var(--color-muted);
  }
  .legal-content :global(ul) {
    margin-bottom: 1rem;
    list-style: disc;
    padding-left: 1.5rem;
    color: var(--color-muted);
  }
  .legal-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .legal-content :global(a) {
    color: var(--color-forest);
    text-decoration: underline;
  }
  .legal-content :global(strong) {
    color: var(--color-ink);
  }
</style>
