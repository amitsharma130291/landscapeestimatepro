---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Landscape Estimate Pro</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    {/* Same-origin link clicks within /app/* are intercepted and swapped in
        place instead of a full browser navigation — the sidebar/header no
        longer visibly "reload" between tabs. Scoped to this layout only
        (the public marketing site keeps plain navigation); each tab's
        AppShell island still mounts fresh on every swap since it isn't
        marked transition:persist, so its `activeTab` always matches the
        new page. */}
    <ClientRouter />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <slot />
  </body>
</html>
