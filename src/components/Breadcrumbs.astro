---
import { SITE_URL } from "../data/site";

export interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: new URL(item.href, SITE_URL).toString(),
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<nav aria-label="Breadcrumb" class="mx-auto max-w-content px-4 pt-4 sm:px-6 lg:px-8">
  <ol class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
    {items.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="font-semibold text-ink">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-forest hover:underline">{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
