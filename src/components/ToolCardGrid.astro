---
import { PRICE_DISPLAY, TOOL_LINKS } from "../data/site";

export interface Props {
  /** Hrefs to exclude (e.g. don't link a tool page to itself). */
  exclude?: string[];
  showProCard?: boolean;
  heading?: string;
  intro?: string;
  /** Shows a "See everything on the resources hub" link near the heading —
   * omit on the resources page itself (which would just link to itself). */
  seeAllHref?: string;
}

const { exclude = [], showProCard = true, heading, intro, seeAllHref } = Astro.props;
const tools = TOOL_LINKS.filter((t) => !exclude.includes(t.href));
const headingId = heading ? `tool-grid-heading-${heading.toLowerCase().replace(/[^a-z0-9]+/g, "-")}` : undefined;
---

<section aria-labelledby={headingId}>
  {heading && (
    <div class="mx-auto max-w-2xl text-center">
      <h2 id={headingId} class="text-2xl font-extrabold text-ink sm:text-3xl">{heading}</h2>
      {intro && <p class="mt-3 text-muted">{intro}</p>}
      {seeAllHref && (
        <a href={seeAllHref} class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-forest hover:underline">
          See every free tool and guide
          <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      )}
    </div>
  )}
  <div class={`grid gap-4 sm:grid-cols-2 lg:grid-cols-3 ${heading ? "mt-8" : ""}`}>
    {tools.map((tool) => (
      <a
        href={tool.href}
        class="group flex flex-col rounded-2xl border border-border bg-white p-5 transition-all hover:-translate-y-0.5 hover:border-lime-surface hover:shadow-md"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-lime-surface">{tool.eyebrow}</span>
        <h3 class="mt-1.5 text-lg font-bold text-ink">{tool.label}</h3>
        <p class="mt-1.5 flex-1 text-sm text-muted">{tool.description}</p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-forest group-hover:gap-1.5 transition-all">
          Open {tool.label}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    ))}

    {showProCard && (
      <a
        href="/landscaping-estimating-software/"
        class="js-pro-upsell-card group flex flex-col rounded-2xl border border-forest-light bg-forest p-5 text-white transition-all hover:-translate-y-0.5 hover:shadow-md"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-lime">Pro software</span>
        <h3 class="mt-1.5 text-lg font-bold">Run the numbers once. Reuse them forever.</h3>
        <p class="mt-1.5 flex-1 text-sm text-white/75">
          Save materials, equipment, labor and production rates once — every future estimate calculates itself.
        </p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-lime group-hover:gap-1.5 transition-all">
          <span class="js-pro-upsell-cta-text">Try Pro free — {PRICE_DISPLAY} planned</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </a>
    )}
  </div>
</section>

<script>
  import { hasStoredLicense } from "../lib/license";

  // A visitor who already owns Pro should be offered a fast way back into
  // the app here too, instead of a "Try Pro free" pitch for something
  // they've already bought.
  if (hasStoredLicense()) {
    document.querySelectorAll<HTMLAnchorElement>(".js-pro-upsell-card").forEach((card) => {
      card.href = "/app/";
      const ctaText = card.querySelector(".js-pro-upsell-cta-text");
      if (ctaText) ctaText.textContent = "Go to App";
    });
  }
</script>
