---
import { TOOL_LINKS } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="no-print border-t border-border-dark bg-forest text-white">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="inline-flex items-center">
          <picture>
            <source srcset="/brand/logo-lockup-dark-v1.webp" type="image/webp" />
            <img src="/brand/logo-lockup-dark-v1.png" alt="Landscape Estimate Pro" width="742" height="162" class="h-[3.375rem] w-auto" />
          </picture>
        </a>
        <p class="mt-3 max-w-xs text-sm text-white/70">
          Estimating and job-costing software for small landscape contractors. $99 lifetime. No account. No subscription. Your data stays on your device.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-lime-surface">Free tools</h3>
        <ul class="mt-3 space-y-2 text-sm">
          {TOOL_LINKS.filter((t) => t.eyebrow !== "Guide").map((tool) => (
            <li><a href={tool.href} class="text-white/80 hover:text-white">{tool.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-lime-surface">Product</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/landscaping-estimating-software/" class="text-white/80 hover:text-white">Landscaping Estimating Software</a></li>
          <li><a href="/landscape-pricing-guide/" class="text-white/80 hover:text-white">Landscape Pricing Guide</a></li>
          <li><a href="/resources/" class="text-white/80 hover:text-white">All Resources</a></li>
          <li><a href="/pricing/" class="text-white/80 hover:text-white">Pricing</a></li>
          <li><a href="/#pro-features" class="text-white/80 hover:text-white">Features</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-lime-surface">Company</h3>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/privacy/" class="text-white/80 hover:text-white">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-white/80 hover:text-white">Terms of Service</a></li>
          <li><a href="/refund/" class="text-white/80 hover:text-white">Refund Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-white/60 sm:flex-row">
      <p>&copy; {year} Landscape Estimate Pro. All rights reserved.</p>
      <p>Pricing guidance is general information, not accounting or legal advice. Verify your own costs and local requirements.</p>
    </div>
  </div>
</footer>
