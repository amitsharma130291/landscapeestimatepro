---
import { NAV_ITEMS } from "../data/site";
---

<header class="no-print sticky top-0 z-50 border-b border-border bg-white/95 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-content items-center justify-between px-4 sm:h-20 sm:px-6 lg:px-8" aria-label="Primary">
    <a href="/" class="flex items-center rounded-lg hover:opacity-90">
      <picture>
        <source srcset="/brand/logo-lockup.webp" type="image/webp" />
        <img
          src="/brand/logo-lockup.png"
          alt="Landscape Estimate Pro"
          width="230"
          height="50"
          class="h-12 w-auto sm:h-[3.375rem]"
        />
      </picture>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {NAV_ITEMS.map((item) => (
        <a href={item.href} class="text-sm font-semibold text-ink/80 transition-colors hover:text-forest">
          {item.label}
        </a>
      ))}
      <a
        href="/pricing/"
        class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-lime px-5 text-sm font-bold text-lime-ink transition-colors hover:bg-[#d9ff5e]"
      >
        Get Lifetime Access
      </a>
    </div>

    <details class="group relative lg:hidden">
      <summary
        class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-lg text-ink hover:bg-paper-dim [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        <svg class="h-6 w-6 group-open:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-6 w-6 group-open:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>
      <div class="absolute right-0 top-full mt-2 w-64 rounded-2xl border border-border bg-white p-3 shadow-lg">
        <ul class="space-y-1">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-[44px] items-center rounded-lg px-3 text-sm font-semibold text-ink hover:bg-paper-dim">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/pricing/"
          class="mt-2 flex min-h-[44px] items-center justify-center rounded-xl bg-lime px-5 text-sm font-bold text-lime-ink hover:bg-[#d9ff5e]"
        >
          Get Lifetime Access
        </a>
      </div>
    </details>
  </nav>
</header>
