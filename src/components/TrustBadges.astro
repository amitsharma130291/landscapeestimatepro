---
import { PRICE_DISPLAY } from "../data/site";

export interface Props {
  variant?: "light" | "dark";
}
const { variant = "light" } = Astro.props;
const items = [
  "No account required",
  "Data stays on your device",
  `Free to use — ${PRICE_DISPLAY} lifetime planned`,
];
const textClass = variant === "dark" ? "text-white/85" : "text-muted";
const iconClass = variant === "dark" ? "text-lime" : "text-lime-surface";
---

<ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-medium">
  {items.map((item) => (
    <li class={`flex items-center gap-2 ${textClass}`}>
      <svg class={`h-4 w-4 shrink-0 ${iconClass}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
      {item}
    </li>
  ))}
</ul>
