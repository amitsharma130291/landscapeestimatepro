# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"). Create a GA4 property at
# analytics.google.com, add a Web data stream for this domain, and paste its Measurement ID
# here. Leave blank to ship with analytics fully disabled (no script loads, all track()
# calls in src/lib/analytics.ts are silent no-ops).
PUBLIC_GA_MEASUREMENT_ID=

# Every page except a handful of small serverless functions under /api runs entirely
# client-side — nothing about the Pro workspace (customer data, project data) is ever sent to
# a server. Those functions (contact form + Dodo Payments checkout/license) are plain
# root-level Vercel functions, not Astro API routes — see api/contact.ts's own comment for why
# (this project has no server adapter). Set all of the following as server-only variables in
# your Vercel project's Environment Variables (Settings -> Environment Variables) — never
# commit real values here.

# The Gmail address to send FROM. In Google Account settings, turn on 2-Step Verification,
# then create an "App password" (myaccount.google.com/apppasswords) for this address — do not
# use your normal account password here.
GMAIL_USER=

# The 16-character App password generated above (no spaces).
GMAIL_APP_PASSWORD=

# Where contact-form messages AND every order/failure notification email are delivered.
CONTACT_TO_EMAIL=

# --- Dodo Payments (Pro license checkout) -----------------------------------------------
# Create a Dodo Payments account at dodopayments.com, then in the dashboard: create a
# one-time-payment product for Landscape Estimate Pro ($99), copy its product id, and
# generate an API key. Leave DODO_ENVIRONMENT=test_mode until you're ready to accept real
# payments — test mode uses Dodo's own test card numbers, no real money moves.

# API key from Dodo dashboard -> Developer -> API Keys.
DODO_PAYMENTS_API_KEY=

# "test_mode" or "live_mode".
DODO_ENVIRONMENT=test_mode

# The product id of your one-time-payment Pro product (starts with "pdt_").
DODO_PRODUCT_ID_PRO=

# Dodo dashboard -> Developer -> Webhooks -> add an endpoint pointing at
# https://<your-domain>/api/webhook-dodo, then copy its signing secret here. This is what
# lets the webhook handler tell a real Dodo request apart from a forged one.
DODO_PAYMENTS_WEBHOOK_KEY=
