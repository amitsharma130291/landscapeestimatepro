# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# Google Analytics 4 Measurement ID (e.g. "G-XXXXXXXXXX"). Create a GA4 property at
# analytics.google.com, add a Web data stream for this domain, and paste its Measurement ID
# here. Leave blank to ship with analytics fully disabled (no script loads, all track()
# calls in src/lib/analytics.ts are silent no-ops).
PUBLIC_GA_MEASUREMENT_ID=

# This app has no payment provider, and every page except one runs entirely client-side —
# nothing about the Pro workspace (customer data, project data, or a purchase) is ever sent
# to a server. See src/data/salesConfig.ts for the $99 planned-price / sales-disabled state,
# which is a plain source file, not an env var.
#
# The one exception is the public contact form (src/pages/api/contact.ts), which sends a
# visitor's message over Gmail SMTP. It needs these three server-only variables, set in your
# Vercel project's Environment Variables (Settings -> Environment Variables) — never commit
# real values here.

# The Gmail address to send FROM. In Google Account settings, turn on 2-Step Verification,
# then create an "App password" (myaccount.google.com/apppasswords) for this address — do not
# use your normal account password here.
GMAIL_USER=

# The 16-character App password generated above (no spaces).
GMAIL_APP_PASSWORD=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=
